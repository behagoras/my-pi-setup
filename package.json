{
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.218",
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^0.82.0",
    "acorn": "^8.17.0",
    "firecrawl": "^4.30.0",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/**/*.{ts,cjs}\" \"scripts/*.mjs\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs}\" \"scripts/*.mjs\" \"*.json\"",
    "test": "node --test --experimental-strip-types extensions/*/*.test.ts scripts/*.test.mjs && npm --prefix extensions/file-search test",
    "patch:scoped-models": "node scripts/patch-pi-scoped-models.mjs --apply",
    "patch:scoped-models:check": "node scripts/patch-pi-scoped-models.mjs --check"
  }
}
